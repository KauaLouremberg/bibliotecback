# Copie para `.env` na raiz deste projeto e ajuste os valores.
# Carregue as variáveis no shell antes de `runserver`, ou use um gestor como `direnv`.

# Opcional: PostgreSQL. Se definido, o Django usa esta base em vez de SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Com TLS obrigatório (ssl_require ativado quando a URL indica na query):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

DJANGO_SECRET_KEY=altere-esta-chave-em-desenvolvimento
DJANGO_DEBUG=1

# Lista separada por vírgulas, sem espaços obrigatórios (espaços são removidos).
# Inclua o IP local da máquina para aceder de Expo num dispositivo na LAN.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# Origens CORS permitidas (Expo Metro costuma usar porta 8081).
# Exemplo com IP da LAN: http://192.168.1.100:8081,exp://192.168.1.100:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:8081

# Tempo de vida dos tokens JWT (Simple JWT).
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
