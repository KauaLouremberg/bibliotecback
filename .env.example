# --- Local (dev) ---
DATABASE_URL=postgresql://postgres:senha@127.0.0.1:5432/bibliotecdb

DJANGO_SECRET_KEY=altere-esta-chave-em-desenvolvimento
DJANGO_DEBUG=1

# Inclua o IP da máquina na LAN para o telemóvel (ex.: 192.168.1.10)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.10

# Origens do Metro/Expo (ajuste o IP se necessário)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.10:8081,exp://192.168.1.10:8081

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Redis local (chat). Em produção no Render, vem do Key Value acervo-redis.
REDIS_URL=redis://127.0.0.1:6379/0

